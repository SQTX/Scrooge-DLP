# ScroogeDLP - production manager config template.
#
# Kopiowane do `deploy/docker/manager.yaml` przez `quickstart.sh`.
# `${VAR}` placeholdery są podmieniane na rzeczywiste wartości.
#
# Ścieżki są wewnątrz kontenera (montowane z hosta przez compose volumes).

server:
  grpc_listen_addr: "0.0.0.0:5443"
  rest_listen_addr: "0.0.0.0:55000"
  tls_cert_path:    "/var/lib/scrooge/certs/server.pem"
  tls_key_path:     "/var/lib/scrooge/certs/server.key"
  ca_cert_path:     "/var/lib/scrooge/certs/ca.pem"
  ca_key_path:      "/var/lib/scrooge/certs/ca.key"

database:
  # `postgres` to nazwa serwisu w docker-compose (DNS w bridge network).
  url:      "postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}"
  pool_max: 16

syslog_forwarder:
  enabled: false

auth:
  jwt_secret:             "${JWT_SECRET}"
  access_token_ttl_secs:  3600
  refresh_token_ttl_secs: 2592000

# Preferencje dashboardu - serwowane przez GET /api/v1/dashboard/config.
# Production-safe default: hard logout po godzinie.
dashboard:
  auto_refresh:
    enabled:        true
    interval_secs:  10
    mode:           "active_only"   # active_only | always | off
  session:
    idle_timeout_secs:     3600
    absolute_timeout_secs: 3600
    warn_before_secs:      60
    extend_on_activity:    false
